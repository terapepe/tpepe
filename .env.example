# WalletConnect Cloud project id (enables mobile wallets via QR). https://cloud.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=
# Optional RPC overrides
NEXT_PUBLIC_ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# ---- Campaign backend (server only, never NEXT_PUBLIC) ----
# Supabase project URL, plus EITHER the service-role key OR the publishable key + SERVER_DB_KEY
# (SERVER_DB_KEY's SHA-256 must be in private.server_keys, see supabase/migrations/0003)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SERVER_DB_KEY=
# Random secrets, e.g. `openssl rand -hex 32`
SESSION_SECRET=
IP_SALT=
CRON_SECRET=
# Private key of the admin/signer wallet set in the contract. Signs claim vouchers and sends finalize().
ADMIN_PRIVATE_KEY=
# Deployed TeraPepeCampaigns address on Robinhood Chain
NEXT_PUBLIC_CAMPAIGNS_CONTRACT=
# Optional: counted events per IP / per browser, per campaign and kind (defaults 3 / 1)
REF_IP_LIMIT=3
REF_DEVICE_LIMIT=1
